PORT=5000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=bus_tracker

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
OTP_SECRET=replace_with_a_separate_long_random_string
INSTITUTIONAL_EMAIL_DOMAIN=pust.ac.bd

# SMTP settings used to deliver registration verification codes
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=PUST Bus Tracker <noreply@example.com>

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Timing thresholds for the prediction engine (milliseconds)
CONFIRMED_TIMEOUT_MS=20000
STALE_TIMEOUT_MS=240000
PREDICTION_TICK_MS=5000
